---
import type { Lang } from '../i18n/ui';

interface Activity {
  date: Date;
  count?: number;
}

interface Props {
  activities: Activity[];
  lang: Lang;
}

const { activities, lang } = Astro.props;
const latest = activities.reduce((value, item) => Math.max(value, item.date.getTime()), 0);
const year = latest ? new Date(latest).getFullYear() : new Date().getFullYear();
const start = new Date(year, 0, 1);
const end = new Date(year, 11, 31);
const counts = new Map<string, number>();

function key(date: Date): string {
  return date.toISOString().slice(0, 10);
}

for (const activity of activities) {
  counts.set(key(activity.date), (counts.get(key(activity.date)) ?? 0) + (activity.count ?? 1));
}

const firstSunday = new Date(start);
firstSunday.setDate(start.getDate() - start.getDay());
const lastSaturday = new Date(end);
lastSaturday.setDate(end.getDate() + (6 - end.getDay()));
const days: Array<{ date: Date; count: number; inYear: boolean }> = [];
for (const cursor = new Date(firstSunday); cursor <= lastSaturday; cursor.setDate(cursor.getDate() + 1)) {
  const date = new Date(cursor);
  days.push({ date, count: counts.get(key(date)) ?? 0, inYear: date.getFullYear() === year });
}

const maxCount = Math.max(...days.map((day) => day.count), 1);
const weeks = Array.from({ length: Math.ceil(days.length / 7) }, (_, index) => days.slice(index * 7, index * 7 + 7));
const monthLabels = weeks
  .map((week, index) => ({ label: week[0]?.date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { month: 'short' }), index }))
  .filter(({ index }) => weeks[index][0].date.getFullYear() === year && (index === 0 || weeks[index - 1][0].date.getMonth() !== weeks[index][0].date.getMonth()));
const weekdayLabels = lang === 'zh' ? ['日', '一', '二', '三', '四', '五', '六'] : ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const heading = lang === 'zh' ? `${year} 年活动` : `${year} activity`;
const emptyLabel = lang === 'zh' ? '没有记录' : 'No activity';
const countLabel = lang === 'zh' ? '条记录' : 'entries';
---

<section class="activity" aria-labelledby="activity-heading">
  <div class="activity-heading">
    <h2 id="activity-heading">{heading}</h2>
    <span>{lang === 'zh' ? '文章与照片' : 'Posts and photos'}</span>
  </div>
  <div class="activity-scroll">
    <div class="activity-chart">
      <div class="activity-months" aria-hidden="true">
        {monthLabels.map(({ label, index }) => <span style={`grid-column: ${index + 1};`}>{label}</span>)}
      </div>
      <div class="activity-body">
        <div class="activity-weekdays" aria-hidden="true">
          {weekdayLabels.map((label, index) => <span class:list={{ 'weekday-hidden': index % 2 === 0 }}>{label}</span>)}
        </div>
        <div class="activity-grid">
          {weeks.map((week) => (
            <div class="activity-week">
              {week.map(({ date, count, inYear }) => {
                const level = count === 0 ? 0 : Math.min(4, Math.ceil((count / maxCount) * 4));
                const label = count === 0 ? emptyLabel : `${count} ${countLabel}`;
                return <a class:list={{ 'activity-day': true, [`activity-level-${level}`]: true, 'activity-outside': !inYear }} href={`?date=${key(date)}`} title={`${date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US')}: ${label}`} aria-label={`${date.toISOString().slice(0, 10)}: ${label}`}></a>;
              })}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="activity-legend" aria-hidden="true">
    <span>{emptyLabel}</span>
    <i class="activity-day activity-level-0"></i><i class="activity-day activity-level-1"></i><i class="activity-day activity-level-2"></i><i class="activity-day activity-level-3"></i><i class="activity-day activity-level-4"></i>
  </div>
</section>
